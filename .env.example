# Configuration for parcel data finder
# Copy this file to .env and update with your settings

# Minimum parcel size in acres
MIN_PARCEL_SIZE_ACRES=9

# Counties to analyze (comma-separated)
COUNTIES=Coconino,Yavapai,Mohave,Navajo

# Output directory for results
OUTPUT_DIR=./output

# Data cache directory
DATA_DIR=./data
